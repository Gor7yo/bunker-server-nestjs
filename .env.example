DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bunker_db"
PORT=3000
CLIENT_ORIGIN="http://localhost:5173"
# Minimal players to start a game (default 4). Set to 2 for local testing.
MIN_PLAYERS=2

# Voice & video (LiveKit). Put real values into .env.local — it is git-ignored.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
